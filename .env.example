# JakTrafic local environment scaffold
# Copy this file to .env and adjust values for your environment.

# Application identity
USER_APP_NAME=jaktrafic
USER_APP_VERSION=0.1.0

# Runtime
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=5000
FLASK_ENV=lite
API_BASE_PATH=/api/v1

# Security
SECRET_KEY=changeme-generate-random-secret-key

# GTFS data source
DATA_FOLDER=data
GTFS_SOURCE_PATH=data
GTFS_SOURCE_ARCHIVE=data/gtfs.zip

# Logging
LOG_DIR=log
LOG_FILE_NAME=web.log
LOG_LEVEL=DEBUG
LOG_ALL_REQUESTS=true
LOG_SLOWER_THAN=50

# Database (local sqlite defaults)
SQLALCHEMY_DATABASE_URI=sqlite:///jaktrafic_lite.sqlite
LOG_DB_CONNSTR=sqlite:///jaktrafic_lite_log.sqlite

# Bootstrap users for local setup
ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=changeme-admin-password
USER_FREE_NAME=free_user
USER_FREE_EMAIL=free@example.com
USER_FREE_PASS=changeme-free-password
USER_PRO_NAME=pro_user
USER_PRO_EMAIL=pro@example.com
USER_PRO_PASS=changeme-pro-password

# Mail
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_SERVER=your-smtp-server.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER="Your Name" <your-email@example.com>
USER_EMAIL_SENDER_EMAIL=your-email@example.com
MAIL_SUPPRESS_SEND=false
